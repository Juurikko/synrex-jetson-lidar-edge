+// LAS integer predictors operate modulo 2^32. Map the unsigned result back
+// without an out-of-range unsigned-to-signed conversion (C++17 portable).
+inline int32_t signed32(uint32_t value)
+{
+    return value <= uint32_t((std::numeric_limits<int32_t>::max)()) ?
+        int32_t(value) : -1 - int32_t((std::numeric_limits<uint32_t>::max)() - value);
+}
+
+inline int32_t add32(int32_t a, int32_t b)
+{
+    return signed32(uint32_t(a) + uint32_t(b));
+}
